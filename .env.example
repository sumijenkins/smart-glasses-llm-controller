# Smart Glasses LLM Controller Configuration

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# LLM Settings
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.2

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Client Configuration
BACKEND_URL=http://localhost:8000
WHISPER_MODEL_SIZE=tiny

# Hardware Flags (Set to false for simulation/mock mode)
ENABLE_CAMERA=false
ENABLE_HARDWARE_MIC=false
